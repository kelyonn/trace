# Copy to .env and adjust. Every variable is optional.

# Initial source: auto (Trino if reachable, else last used / Retail demo), embedded, trino
ENGINE=auto
TRINO_URL=http://localhost:8080

# API
PORT=3000
AUTH_REQUIRED=false          # true: require a bearer API key or Keycloak JWT; only admins can add sources
API_KEY=
KEYCLOAK_ENABLED=false
OPA_ENABLED=false
OPA_URL=http://localhost:8181
RATE_LIMIT_MAX=0

# PII masked for non-admin roles: bare column names or table.column
MASK_COLUMNS=customers.name,drivers.name,email,phone

# Query limits
MAX_RESULT_ROWS=50000
STATEMENT_TIMEOUT_MS=30000
PAGE_SIZE=1000
PROFILE_SAMPLE_ROWS=50000

# Embedded storage (demo + uploads live under ./data by default)
EMBEDDED_PERSIST=true
UPLOAD_MAX_ROWS=500000
UPLOAD_MAX_BYTES=62914560

# Web
VITE_API_ORIGIN=http://localhost:3000
